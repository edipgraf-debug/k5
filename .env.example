# --- Genel ---
SITE_URL=https://kardelenokul.com
# En az 32 karakterlik rastgele bir değer (oturum çerezi imzası)
SESSION_SECRET=degistir-bunu-en-az-32-karakterlik-rastgele-bir-deger
# Canlıda boş bırakın (HTTPS'te otomatik true). Yerelde http://localhost ile "next start" denerken false yapın.
COOKIE_SECURE=

# Okul logolarının saklandığı kalıcı klasör (yüklemeler buraya yazılır; uygulama güncellemelerinde silinmemeli)
# Boş bırakılırsa çalışma klasöründeki veri/okul-logolari kullanılır.
LOGO_DIZINI=

# --- Veri kaynağı ---
# mock  : örnek verilerle çalışır (SQL Server gerekmez; geliştirme ve demo için)
# mssql : KardelenOkul veritabanı (db/schema.sql)
DATA_SOURCE=mock
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=KardelenOkul
MSSQL_USER=kardelen_web
MSSQL_PASSWORD=
MSSQL_ENCRYPT=false
MSSQL_TRUST_CERT=true

# --- SMS ---
# console: SMS'leri sunucu günlüğüne yazar (geliştirme)
# http   : SMS firmasının HTTP API'si (src/lib/notify/sms.ts içinde firmaya göre uyarlanır)
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_USER=
SMS_API_PASSWORD=
SMS_SENDER=KARDELENOKL

# --- E-posta (SMTP) ---
# console: e-postaları günlüğe yazar; smtp: gerçek gönderim
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Kardelen Okul <bilgi@kardelenokul.com>"

# --- Opak ---
# Kalıtım B2B'nin kullandığı action tabanlı servis (POST {action, data})
OPAK_API_URL=
OPAK_API_KEY=
